rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidPrompt(data) {
      return data.keys().hasAll(['title', 'prompt', 'description', 'category', 'imageUrl', 'createdAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.prompt is string && data.prompt.size() > 0 && data.prompt.size() <= 5000
        && data.description is string && data.description.size() <= 1000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 2048
        && data.createdAt is string && data.createdAt.size() <= 50
        && (!('negativePrompt' in data) || (data.negativePrompt is string && data.negativePrompt.size() <= 1000))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
        && (!('model' in data) || (data.model is string && data.model.size() <= 100))
        && (!('aspectRatio' in data) || (data.aspectRatio is string && data.aspectRatio.size() <= 20))
        && (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0))
        && (!('copyCount' in data) || (data.copyCount is number && data.copyCount >= 0))
        && (!('featured' in data) || (data.featured is bool))
        && (!('isPopular' in data) || (data.isPopular is bool));
    }

    // Prompts Collection
    match /prompts/{promptId} {
      allow get, list: if true;

      // Allow visitors to increment stats counters without modifying prompt contents
      allow update: if (
        // Action: Like increment
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) &&
         incoming().likesCount is number &&
         incoming().likesCount >= existing().likesCount &&
         incoming().likesCount <= existing().likesCount + 1)
        ||
        // Action: Copy count increment
        (incoming().diff(existing()).affectedKeys().hasOnly(['copyCount']) &&
         incoming().copyCount is number &&
         incoming().copyCount >= existing().copyCount &&
         incoming().copyCount <= existing().copyCount + 1)
        ||
        // Action: Views count increment
        (incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount']) &&
         incoming().viewsCount is number &&
         incoming().viewsCount >= existing().viewsCount &&
         incoming().viewsCount <= existing().viewsCount + 1)
        ||
        // Authenticated admin / system updates
        (isSignedIn() && isValidId(promptId) && isValidPrompt(incoming()))
      );

      allow create, update, delete: if true;
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() || (
        incoming().keys().hasAll(['name']) &&
        incoming().name is string && incoming().name.size() <= 100
      );
      allow delete: if isSignedIn();
    }
  }
}
